# Your filled-in configuration is yours, not the blueprint's
config.md
*.conf
!*.conf.example

# Receipts and QA artefacts are per-site, never committed
.qa-receipt
_qa/
*.bak-*

# Battery run artefacts. `.ultima-bateria` records the LAST run, and committing it
# is how a stale number gets quoted as current: a `--fast` run overwrites it with a
# partial count that reads exactly like a full one.
gates/.ultima-bateria
gates/*-tests/work/
gates/*-tests/out/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Scratch tree rebuilt from scratch by anatomy-tests/tests.pl on every run.
# One file of it slipped into git once (870b401) and has been shipping a stale
# duplicate of blueprint/09-page-types.md ever since: a second copy of a truth,
# which is the one thing this repo says never to keep.
gates/anatomy-tests/.tmp-anatomy/
